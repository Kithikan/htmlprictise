<html>
<head>
    <title>Ordered Lists</title>
</head>

<body>

    <h1>Ordered List with Type</h1>

    <ol type="A">
        <li>Maths</li>
        <li>Science</li>
        <li>English</li>
    </ol>


    <h1>Ordered List with Start Attribute</h1>

    <ol start="5">
        <li>Item Five</li>
        <li>Item Six</li>
        <li>Item Seven</li>
    </ol>


    <h1>Reversed Ordered List</h1>

    <ol reversed start="3">
        <li>Step One</li>
        <li>Step Two</li>
        <li>Step Three</li>
    </ol>

</body>
</html>